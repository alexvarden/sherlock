# Copy to .env and fill in your own values. Never commit .env.

# --- OpenAI (used only at ingest/analysis time, not for retrieval) ---
OPENAI_API_KEY=
OPENAI_ORGANISATION=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-4o-mini

# --- Neo4j (the graph backend) ---
# Local: bolt://localhost:7687 (see docker-compose.yml)
# Hosted: your Neo4j Aura connection URI
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
