# Copy to .env and fill in your own values. Never commit .env.

# --- OpenAI (used only at ingest/analysis time, not for retrieval) ---
OPENAI_API_KEY=
OPENAI_ORGANISATION=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-4o-mini

# --- Postgres (the graph backend) ---
# Local: the docker-compose service, already populated from data/seed.
#   postgres://postgres:sherlock@localhost:5432/sherlock
# Hosted: the Sherlock Neon project's pooled connection string.
# Use a read-only role for anything that only reads; the loader and the
# migration runner are the only things that need write access.
SHERLOCK_DATABASE_URL=postgres://postgres:sherlock@localhost:5432/sherlock
